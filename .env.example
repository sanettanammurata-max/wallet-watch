# Wallet Watch environment template

# Choose either Postgres or SQLite for local development.
# Local free setup: keep SQLITE as the default.
DATABASE_URL="sqlite:./wallet-watch.db"

# Optional blockchain / monitoring configuration
ALCHEMY_API_KEY=""
HELIUS_API_KEY=""
WEBHOOK_SIGNING_SECRET="change-me"
CRON_SECRET="change-me"
APP_URL="http://localhost:3000"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Wallet monitoring defaults
SCAN_THRESHOLD_ETH="0.01"

# Production only if you use provider webhooks
ALCHEMY_NOTIFY_URL=""
ALCHEMY_AUTH_TOKEN=""
